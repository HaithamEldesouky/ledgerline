# Normalise all text files to LF in the repository to keep Linux CI
# (gofmt, shell scripts, YAML) consistent regardless of contributor OS.
* text=auto eol=lf

*.go      text eol=lf
*.mod     text eol=lf
*.sum     text eol=lf
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.tf      text eol=lf
*.md      text eol=lf
Makefile  text eol=lf
Dockerfile text eol=lf

# Binary assets (none yet, but future-proof).
*.png binary
*.jpg binary
*.gif binary
