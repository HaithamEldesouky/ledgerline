# ─────────────────────────────────────────────────────────────
# LedgerLine — environment configuration (12-factor)
# Copy to `.env` for local development: cp .env.example .env
# ─────────────────────────────────────────────────────────────

# HTTP server
HOST=0.0.0.0
PORT=8080

# Runtime environment: development | test | production
APP_ENV=development

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Persistence backend: memory | postgres
#   memory   : in-process store, great for local dev and demos (no DB needed)
#   postgres : durable store, requires DATABASE_URL below
STORAGE_DRIVER=memory

# PostgreSQL connection string (required when STORAGE_DRIVER=postgres)
DATABASE_URL=postgres://ledgerline:ledgerline@localhost:5432/ledgerline?sslmode=disable

# Per-IP rate limiting (token bucket)
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# Graceful shutdown grace period
SHUTDOWN_TIMEOUT=15s
